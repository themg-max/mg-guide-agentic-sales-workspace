# =============================================================================
# MG Guide Agentic Sales Workspace — environment placeholder catalog
# =============================================================================
# PLACEHOLDER CATALOG ONLY. No real values are present or required here.
# Phase 3 Unit 2 runs fully offline (synthetic transcripts + synthetic CRM)
# and needs no secrets. NEVER commit a real .env or real secret values.
# NEVER point these at production CRM or production GCP projects.
# =============================================================================

# --- Google / Gemini (Phase 3 Meeting Context Agent; optional live mode) ---
# Default harness/CI uses fixture or gemini_adk_stub (no key required).
# GEMINI_API_KEY=
# MEETING_CONTEXT_GEMINI_MODE=stub   # stub | live
# MEETING_CONTEXT_GEMINI_MODEL=gemini-2.0-flash
# GOOGLE_CLOUD_PROJECT=  # test/sandbox project only; UNKNOWN until provisioned
# GOOGLE_CLOUD_REGION=   # UNKNOWN until provisioned
# GOOGLE_GENAI_MODEL=    # optional override; exact production model id UNKNOWN
#
# --- Google ADK runtime (Phase 3 Unit 2; google-adk package backend) ---
# Unit 2 orchestrates via actual google.adk primitives (Runner, SequentialAgent,
# InMemorySessionService). The google-adk package is REQUIRED (pinned in
# requirements.txt); there is no local fallback — the runtime fails closed
# when the package is unavailable.
# No live CRM/GHL/Firestore side effects in Unit 2.

# --- Firestore audit (future) ---
# FIRESTORE_PROJECT_ID=  # must match authorized test project; UNKNOWN
# FIRESTORE_COLLECTION_WORKFLOW_RUNS=workflow_runs

# --- GHL MCP / CRM boundary (future) ---
# Live GHL remains UNUSED and UNAUTHORIZED by Phase 3 Unit 2. Unit 2 reads
# synthetic fixtures only via the Phase 2B offline adapter (zero live calls,
# zero writes). No isolated GHL test location is available; the retired
# isolated-test-account path must not be described as available. The canonical
# GHL location is NOT a test environment and must not be treated as one.
# GHL_MCP_ENDPOINT=      # UNKNOWN until authorized discovery
# GHL_LOCATION_ID=       # UNKNOWN; canonical location is not a test location
# GHL_AUTH_MODE=oauth_or_pit  # placeholder label only
# GHL_ACCESS_TOKEN=      # NEVER commit; store in secret manager later
# GHL_ALLOW_MUTATIONS=false
# GHL_ENVIRONMENT=hackathon_placeholder_not_provisioned

# --- MG MCP context (read-only; future) ---
# MG_MCP_ENDPOINT=       # UNKNOWN in this public repo; do not invent
# MG_MCP_MODE=read_only

# --- App / demo ---
# APP_ENV=local
# LOG_LEVEL=info
# ALLOW_PRODUCTION_CRM_WRITES=false
