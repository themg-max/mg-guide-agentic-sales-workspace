{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://mg-guide.example/contracts/relationship_context.schema.json",
  "title": "relationship_context_v1",
  "description": "Structured relationship/CRM context produced by the Relationship Context Agent using Phase 2B offline GHL adapter reads against synthetic fixtures only.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "agent",
    "provider",
    "meeting_ref",
    "resolution",
    "crm_source",
    "evidence",
    "external_effects",
    "policy_authority"
  ],
  "properties": {
    "schema": {
      "type": "string",
      "const": "relationship_context_v1"
    },
    "agent": {
      "type": "string",
      "const": "relationship_context_agent"
    },
    "provider": {
      "type": "string",
      "enum": ["offline_ghl_fixture", "adk_runtime_offline"]
    },
    "meeting_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meeting_id", "transcript_hash"],
      "properties": {
        "meeting_id": { "type": "string", "minLength": 1 },
        "transcript_hash": { "type": "string", "minLength": 1 },
        "run_id": { "type": ["string", "null"] }
      }
    },
    "resolution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "lifecycle",
        "status",
        "contact_id",
        "opportunity_id",
        "match_basis",
        "candidate_count",
        "current_stage",
        "candidates",
        "contact",
        "opportunity"
      ],
      "properties": {
        "lifecycle": {
          "type": "string",
          "enum": ["complete", "failed"]
        },
        "status": {
          "type": "string",
          "enum": [
            "matched",
            "ambiguous",
            "not_found",
            "opportunity_missing",
            "insufficient_context",
            "tool_failure"
          ]
        },
        "contact_id": { "type": ["string", "null"] },
        "opportunity_id": { "type": ["string", "null"] },
        "match_basis": {
          "type": "string",
          "enum": ["email", "phone", "name", "none"]
        },
        "candidate_count": {
          "type": "integer",
          "minimum": 0
        },
        "current_stage": { "type": ["string", "null"] },
        "candidates": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["contact_id", "display_name", "email", "phone", "match_basis"],
            "properties": {
              "contact_id": { "type": "string" },
              "display_name": { "type": ["string", "null"] },
              "email": { "type": ["string", "null"] },
              "phone": { "type": ["string", "null"] },
              "match_basis": {
                "type": "string",
                "enum": ["email", "phone", "name", "none"]
              }
            }
          }
        },
        "contact": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": ["id", "first_name", "last_name", "email", "phone"],
          "properties": {
            "id": { "type": "string" },
            "first_name": { "type": ["string", "null"] },
            "last_name": { "type": ["string", "null"] },
            "email": { "type": ["string", "null"] },
            "phone": { "type": ["string", "null"] },
            "company_name": { "type": ["string", "null"] }
          }
        },
        "opportunity": {
          "type": ["object", "null"],
          "additionalProperties": false,
          "required": [
            "id",
            "contact_id",
            "pipeline_id",
            "pipeline_stage_id",
            "name",
            "status"
          ],
          "properties": {
            "id": { "type": "string" },
            "contact_id": { "type": "string" },
            "pipeline_id": { "type": ["string", "null"] },
            "pipeline_stage_id": { "type": ["string", "null"] },
            "name": { "type": ["string", "null"] },
            "status": { "type": ["string", "null"] },
            "stage_name": { "type": ["string", "null"] },
            "monetary_value": { "type": ["number", "null"] }
          }
        }
      }
    },
    "crm_source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "adapter",
        "live_calls",
        "writes",
        "real_customer_data",
        "operations_used"
      ],
      "properties": {
        "mode": {
          "type": "string",
          "const": "offline_synthetic"
        },
        "adapter": {
          "type": "string",
          "const": "phase2b_offline_ghl_read_adapter"
        },
        "live_calls": {
          "type": "integer",
          "const": 0
        },
        "writes": {
          "type": "integer",
          "const": 0
        },
        "real_customer_data": {
          "type": "integer",
          "const": 0
        },
        "operations_used": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "search-contacts-advanced",
              "get-contact",
              "search-opportunity",
              "get-pipelines"
            ]
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["participant_keys", "resolution_confidence", "notes"],
      "properties": {
        "participant_keys": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["role", "name", "email", "phone"],
            "properties": {
              "role": { "type": "string" },
              "name": { "type": ["string", "null"] },
              "email": { "type": ["string", "null"] },
              "phone": { "type": ["string", "null"] }
            }
          }
        },
        "resolution_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "external_effects": {
      "type": "integer",
      "const": 0
    },
    "policy_authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deterministic_policy_bypass", "notes"],
      "properties": {
        "deterministic_policy_bypass": {
          "type": "boolean",
          "const": false
        },
        "notes": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
