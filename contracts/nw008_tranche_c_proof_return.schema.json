{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/themg-max/mg-guide-agentic-sales-workspace/contracts/nw008_tranche_c_proof_return.schema.json",
  "title": "nw008_tranche_c_proof_return_v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "execution_unit",
    "purpose",
    "implementation_subject_sha",
    "transcript_source_contract",
    "targets",
    "excludes",
    "scenarios",
    "proof_obligations",
    "effect_counters",
    "historical_at_claims",
    "remaining_gaps"
  ],
  "properties": {
    "execution_unit": {
      "type": "string",
      "const": "TRANCHE_C"
    },
    "purpose": {
      "type": "string",
      "const": "HISTORICAL_FAILURE_PATH_AGENT_FLEET_ACCEPTANCE_REPLAY"
    },
    "implementation_subject_sha": {
      "type": "string",
      "minLength": 7
    },
    "transcript_source_contract": {
      "type": "string",
      "const": "TRANSCRIPT_SOURCE_ENVELOPE_V1"
    },
    "targets": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["AT-2", "AT-4", "AT-5"]
      },
      "minItems": 3,
      "maxItems": 3
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "scenarios": {
      "type": "object",
      "additionalProperties": false,
      "required": ["AT-2", "AT-4", "AT-5"],
      "properties": {
        "AT-2": {
          "$ref": "#/$defs/scenarioRun"
        },
        "AT-4": {
          "$ref": "#/$defs/scenarioRun"
        },
        "AT-5": {
          "$ref": "#/$defs/scenarioRun"
        }
      }
    },
    "proof_obligations": {
      "type": "object",
      "patternProperties": {
        "^TC-(0[1-9]|1[0-9]|2[0-2])$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "STATUS",
            "EVIDENCE_PATH",
            "DETAIL",
            "REMAINING_GAP"
          ],
          "properties": {
            "STATUS": {
              "type": "string",
              "enum": [
                "PASS",
                "FAIL",
                "PARTIAL",
                "BLOCKED"
              ]
            },
            "EVIDENCE_PATH": {
              "type": "string"
            },
            "DETAIL": {
              "type": "string"
            },
            "REMAINING_GAP": {
              "type": "string"
            }
          }
        }
      },
      "additionalProperties": false
    },
    "effect_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "GHL_LIVE_CALLS",
        "GHL_READS",
        "GHL_WRITES",
        "FIRESTORE_WRITES",
        "EXTERNAL_EFFECTS",
        "REAL_CUSTOMER_DATA",
        "NW013_EXECUTED",
        "DEPLOYMENT_PERFORMED"
      ],
      "properties": {
        "GHL_LIVE_CALLS": {
          "type": "integer",
          "const": 0
        },
        "GHL_READS": {
          "type": "integer",
          "const": 0
        },
        "GHL_WRITES": {
          "type": "integer",
          "const": 0
        },
        "FIRESTORE_WRITES": {
          "type": "integer",
          "const": 0
        },
        "EXTERNAL_EFFECTS": {
          "type": "integer",
          "const": 0
        },
        "REAL_CUSTOMER_DATA": {
          "type": "integer",
          "const": 0
        },
        "NW013_EXECUTED": {
          "type": "string",
          "const": "NO"
        },
        "DEPLOYMENT_PERFORMED": {
          "type": "string",
          "const": "NO"
        }
      }
    },
    "historical_at_claims": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "AT-2",
        "AT-4",
        "AT-5"
      ],
      "properties": {
        "AT-2": {
          "$ref": "#/$defs/historicalClaim"
        },
        "AT-4": {
          "$ref": "#/$defs/historicalClaim"
        },
        "AT-5": {
          "$ref": "#/$defs/historicalClaim"
        }
      }
    },
    "remaining_gaps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "entrypoints": {
      "type": "object"
    }
  },
  "$defs": {
    "scenarioRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "envelope_path",
        "envelope_hash",
        "run_id",
        "run_path",
        "agents_started",
        "agents_completed",
        "stop_point",
        "stop_reason_code",
        "stop_reason_source",
        "policy_bypass",
        "disposition",
        "effect_counters"
      ],
      "properties": {
        "envelope_path": {
          "type": "string"
        },
        "envelope_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "run_id": {
          "type": "string"
        },
        "run_path": {
          "type": "string"
        },
        "agents_started": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agents_completed": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "stop_point": {
          "type": "string"
        },
        "stop_reason_code": {
          "type": "string"
        },
        "stop_reason_source": {
          "type": "string"
        },
        "policy_bypass": {
          "type": "boolean"
        },
        "disposition": {
          "type": "string"
        },
        "effect_counters": {
          "type": "object"
        }
      }
    },
    "historicalClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "detail"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "YES",
            "NO",
            "CANDIDATE",
            "EXCLUDED"
          ]
        },
        "detail": {
          "type": "string"
        }
      }
    }
  }
}
